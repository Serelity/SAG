{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sag_semantic_issue_output_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_summary", "issues", "discourse"],
  "properties": {
    "event_summary": {"type": "string"},
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "discourse": {"$ref": "#/$defs/discourse"}
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "field", "evidence"],
      "properties": {
        "surface": {"type": "string"},
        "field": {
          "type": "string",
          "enum": ["title_clean", "case_content_clean", "case_goal_clean", "address_detail_clean"]
        },
        "evidence": {"type": "string"}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "surface", "field", "evidence"],
      "properties": {
        "type": {"type": "string", "enum": ["road", "intersection", "poi"]},
        "surface": {"type": "string"},
        "field": {
          "type": "string",
          "enum": ["title_clean", "case_content_clean", "case_goal_clean", "address_detail_clean"]
        },
        "evidence": {"type": "string"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_scope", "objects", "problem_behaviors", "question_focus", "request_actions", "locations"],
      "properties": {
        "time_scope": {"type": "string", "enum": ["current", "historical"]},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "problem_behaviors": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "question_focus": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "request_actions": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "locations": {"type": "array", "items": {"$ref": "#/$defs/location"}}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "field", "evidence"],
      "properties": {
        "label": {"type": "string", "enum": ["投诉", "举报", "求助", "咨询", "建议", "表扬", "催办", "反馈", "其他"]},
        "field": {"type": "string", "enum": ["title_clean", "case_content_clean", "case_goal_clean", "address_detail_clean"]},
        "evidence": {"type": "string"}
      }
    },
    "emotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "intensity", "field", "evidence"],
      "properties": {
        "label": {"type": "string", "enum": ["愤怒", "不满", "焦虑", "无奈", "悲伤", "感谢", "认可"]},
        "intensity": {"type": "integer", "enum": [1, 2, 3]},
        "field": {"type": "string", "enum": ["title_clean", "case_content_clean", "case_goal_clean", "address_detail_clean"]},
        "evidence": {"type": "string"}
      }
    },
    "satisfaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "target", "field", "evidence"],
      "properties": {
        "label": {"type": "string", "enum": ["satisfied", "dissatisfied", "mixed", "unknown"]},
        "target": {"type": "string"},
        "field": {"type": "string", "enum": ["", "title_clean", "case_content_clean", "case_goal_clean", "address_detail_clean"]},
        "evidence": {"type": "string"}
      }
    },
    "urgency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "field", "evidence"],
      "properties": {
        "level": {"type": "string", "enum": ["normal", "high", "critical"]},
        "field": {"type": "string", "enum": ["", "title_clean", "case_content_clean", "case_goal_clean", "address_detail_clean"]},
        "evidence": {"type": "string"}
      }
    },
    "discourse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intents", "emotions", "satisfaction", "urgency"],
      "properties": {
        "intents": {"type": "array", "items": {"$ref": "#/$defs/intent"}},
        "emotions": {"type": "array", "items": {"$ref": "#/$defs/emotion"}},
        "satisfaction": {"$ref": "#/$defs/satisfaction"},
        "urgency": {"$ref": "#/$defs/urgency"}
      }
    }
  }
}
